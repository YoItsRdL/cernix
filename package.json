{
  "name": "cernix",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.19.0 <25"
  },
  "description": "Photography ingest, RAW editing, and Google Drive distribution in one desktop app",
  "license": "MIT",
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run icons && electron-builder",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:contrast": "electron scripts/check-contrast.cjs",
    "check:canvas": "node scripts/check-canvas-neutral.mjs",
    "check:type": "node scripts/check-type-scale.mjs",
    "check:hierarchy": "electron scripts/check-hierarchy.cjs",
    "test:ui": "electron scripts/ui-tests.cjs",
    "check:design": "node scripts/design-audit.mjs",
    "landing:build": "npm run landing:html && tailwindcss -i landing/src/style.css -o landing/dist/style.css --minify",
    "landing:dev": "tailwindcss -i landing/src/style.css -o landing/dist/style.css --watch",
    "release": "tsc && vite build && electron-builder --win nsis --publish never",
    "release:patch": "npm version patch --no-git-tag-version && npm run release",
    "release:minor": "npm version minor --no-git-tag-version && npm run release",
    "release:major": "npm version major --no-git-tag-version && npm run release",
    "landing:deploy": "node scripts/landing-deploy.mjs",
    "landing:update-binary": "node scripts/landing-update-binary.mjs",
    "prepare": "husky",
    "smoke": "node scripts/smoke-package.mjs",
    "icons": "electron scripts/build-icons.cjs",
    "check:shortcuts": "node scripts/check-shortcuts.cjs",
    "check:motion": "node scripts/check-motion.cjs",
    "landing:html": "node scripts/landing-html.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --no-warn-ignored"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "better-sqlite3": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "exiftool-vendored": "^35.15.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.460.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.10",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^6.0.1",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.2"
  },
  "build": {
    "appId": "app.cernix",
    "productName": "Cernix",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "icon": "build-resources/icon.ico",
    "target": "nsis",
    "nsis": {
      "artifactName": "Cernix-Setup-${version}.${ext}",
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "protobufjs@7.6.5": true
  }
}
